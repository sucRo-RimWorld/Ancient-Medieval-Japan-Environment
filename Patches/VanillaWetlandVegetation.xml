<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    AMJE leaves Vanilla wetland BiomeDefs available for swampy tiles, but their
    inherited plant pools still need the same Japan-oriented retention audit as
    AMJE-owned climate bands. Preserve total vegetation and woody commonality
    while removing plants that do not have a defensible AMJE role.
  -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- TemperateSwamp: 7.30 total / 3.00 woody commonality stay unchanged. -->
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants/Plant_Chokevine</xpath>
        <value>
          <Plant_Brambles>0.8</Plant_Brambles>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants/Plant_TreeWillow</xpath>
        <value>
          <Plant_TreeWillow>2.0</Plant_TreeWillow>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants/Plant_TreeCypress</xpath>
      </li>

      <!-- ColdBog: 8.22 total / 1.80 woody commonality stay unchanged. -->
      <li Class="PatchOperationRemove">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/Plant_Chokevine</xpath>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/Plant_TallGrass</xpath>
        <value>
          <Plant_TallGrass>3.4</Plant_TallGrass>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/Plant_Moss</xpath>
        <value>
          <Plant_Moss>2.6</Plant_Moss>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/Plant_Astragalus</xpath>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/Plant_TreeCypress</xpath>
        <value>
          <Plant_TreeBirch>0.6</Plant_TreeBirch>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
