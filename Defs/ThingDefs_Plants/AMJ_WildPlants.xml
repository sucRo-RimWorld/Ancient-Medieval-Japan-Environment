<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Japan-specific structural vegetation for the four AMJ climate-band biomes.
    The four custom species use approved AMJE graphics and state variants.
    These Defs intentionally add no new harvested item types.
  -->

  <ThingDef ParentName="TreeBase">
    <defName>AMJ_Tree_Shii</defName>
    <label>Sudajii</label>
    <description>Sudajii (also called Itajii or Nagajii) is a tall evergreen tree that forms lucidophyll forest mainly in the warm-temperate regions of southern Honshu, Shikoku, and Kyushu.\n\nForests dominated by shii trees were already widespread in southwestern Japan by the Early Jomon period, and Early Jomon use of Castanopsis fruits has been confirmed at the Ireibaru site in Okinawa.\n\nIts wood has been used for buildings and implements, tannin from the bark for dyeing items such as fishing nets, and its seeds as food.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Shii</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.2, 0.35, 0.13)</volume>
        <offset>(-0.03,0,-0.44)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <plant>
      <growDays>30</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestWork>1000</harvestWork>
      <harvestYield>42</harvestYield>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Shii_Snow</snowOverlayGraphicPath>
      <wildClusterWeight>36</wildClusterWeight>
    </plant>
  </ThingDef>

  <ThingDef ParentName="DeciduousTreeBase">
    <defName>AMJ_Tree_Beech</defName>
    <label>Japanese beech</label>
    <description>Japanese beech (buna; also called Shirobuna or Honbuna; written 山毛欅, 橅, or 椈 in Japanese) is a large deciduous tree representative of Japan's cool-temperate zone, where it forms extensive mountain forests.\n\nCool-temperate forests containing Fagus are also known from northern Honshu in the Jomon period, and examples from the late Heian through medieval period show Fagus wood being selectively used for turned wooden objects such as lacquerware.\n\nIn modern Japan it is also used for furniture, interior materials, mushroom-growing logs, and firewood.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Beech</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderParameters Inherit="False">
        <_FallColorSource>(0.496758088, 0.537254902, 0.323263543)</_FallColorSource>
        <_FallColorDestination>/Other/AMJE_BeechFallGradient</_FallColorDestination>
        <_FallTransitionRange>(0.02, 0.10)</_FallTransitionRange>
        <_FallBehaviorEnabled>1</_FallBehaviorEnabled>
      </shaderParameters>
      <shadowData>
        <volume>(0.16, 0.33, 0.12)</volume>
        <offset>(0,0,-0.44)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <plant>
      <growDays>30</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <leaflessGraphicPath>Things/Plant/AMJ/Beech_Leafless</leaflessGraphicPath>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Beech_Snow</snowOverlayGraphicPath>
      <!-- Deliberately transparent. Without a leafless-specific graphic, the native Plant may reuse leafy snow. -->
      <leaflessSnowOverlayGraphicPath>Things/Plant/AMJ/LeaflessNoSnow</leaflessSnowOverlayGraphicPath>
      <harvestWork>950</harvestWork>
      <harvestYield>40</harvestYield>
      <wildClusterWeight>38</wildClusterWeight>
    </plant>
  </ThingDef>

  <ThingDef ParentName="DeciduousTreeBase">
    <!-- Hannoki: damp-land alder; approved wood/biome weights. Frozen sprites.
         Shared autumn LUT/source sample subject to native color review. -->
    <defName>AMJ_Tree_Hannoki</defName>
    <label>Alder (hannoki)</label>
    <description>Alder (hannoki) is a tall deciduous tree that grows along rivers and in wetlands with a high water table. It forms woods in damp lowlands, shaping wetland landscapes together with reeds and sedges.\n\nStudies of naturally occurring wood recovered from archaeological sites show that wetland forests containing trees of the alder genus existed in valleys of the Kantō region during the Jōmon period. Such forests were one of the forms of natural vegetation found in Japan's river lowlands long ago.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Hannoki</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <!-- Initial Hannoki-specific foliage sample, not beech's color key.
           The LUT is reused only pending fixed-noon native autumn comparison. -->
      <shaderParameters Inherit="False">
        <_FallColorSource>(0.423529412, 0.447058824, 0.262745098)</_FallColorSource>
        <_FallColorDestination>/Other/AMJE_BeechFallGradient</_FallColorDestination>
        <_FallTransitionRange>(0.02, 0.10)</_FallTransitionRange>
        <_FallBehaviorEnabled>1</_FallBehaviorEnabled>
      </shaderParameters>
      <shadowData>
        <volume>(0.16, 0.30, 0.12)</volume>
        <offset>(0,0,-0.44)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <plant>
      <growDays>20</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestTag>Wood</harvestTag>
      <harvestWork>800</harvestWork>
      <harvestYield>24</harvestYield>
      <leaflessGraphicPath>Things/Plant/AMJ/Hannoki_Leafless</leaflessGraphicPath>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Hannoki_Snow</snowOverlayGraphicPath>
      <!-- Deliberately transparent. Without a leafless-specific graphic, the native Plant may reuse leafy snow. -->
      <leaflessSnowOverlayGraphicPath>Things/Plant/AMJ/LeaflessNoSnow</leaflessSnowOverlayGraphicPath>
    </plant>
  </ThingDef>

  <ThingDef ParentName="DeciduousTreeBase">
    <defName>AMJ_Tree_Shirakaba</defName>
    <label>Japanese white birch</label>
    <description>Japanese white birch (shirakaba) is a deciduous white-barked tree of Japan's cool-temperate forests.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Shirakaba</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <!-- Vanilla Birch fall-color baseline. New art color/appearance still awaits native review. -->
      <shaderParameters Inherit="False">
        <_FallColorSource>(0.3803, 0.4352, 0.1451)</_FallColorSource>
        <_FallColorDestination>/Other/TreeFallGradient</_FallColorDestination>
        <_FallTransitionRange>(0.02, 0.10)</_FallTransitionRange>
        <_FallBehaviorEnabled>1</_FallBehaviorEnabled>
      </shaderParameters>
      <shadowData><volume>(0.15, 0.3, 0.1)</volume><offset>(-0.03,0,-0.35)</offset></shadowData>
    </graphicData>
    <statBases><Beauty>2</Beauty><BeautyOutdoors>2</BeautyOutdoors><Nutrition>2</Nutrition></statBases>
    <ingestible />
    <plant>
      <!-- Keep the Vanilla Birch growth and wood economy without adding species bonuses. -->
      <growDays>20</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestWork>800</harvestWork>
      <harvestYield>27</harvestYield>
      <wildClusterWeight>24</wildClusterWeight>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Shirakaba_Snow</snowOverlayGraphicPath>
      <leaflessGraphicPath>Things/Plant/AMJ/Shirakaba_Leafless</leaflessGraphicPath>
      <leaflessSnowOverlayGraphicPath>Things/Plant/AMJ/LeaflessNoSnow</leaflessSnowOverlayGraphicPath>
      <!-- Author-approved snow-only source is installed; loaded-game appearance remains unverified. -->
    </plant>
  </ThingDef>

  <ThingDef ParentName="DeciduousTreeBase">
    <defName>AMJ_Tree_Dakekanba</defName>
    <label>Erman's birch</label>
    <description>Erman's birch (dakekanba) is a deciduous grey-white to pale-brown-barked tree of Japan's cold mountainous and subalpine forests.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Dakekanba</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <!-- Vanilla Birch fall-color baseline. New art color/appearance still awaits native review. -->
      <shaderParameters Inherit="False">
        <_FallColorSource>(0.3803, 0.4352, 0.1451)</_FallColorSource>
        <_FallColorDestination>/Other/TreeFallGradient</_FallColorDestination>
        <_FallTransitionRange>(0.02, 0.10)</_FallTransitionRange>
        <_FallBehaviorEnabled>1</_FallBehaviorEnabled>
      </shaderParameters>
      <shadowData><volume>(0.15, 0.3, 0.1)</volume><offset>(-0.03,0,-0.35)</offset></shadowData>
    </graphicData>
    <statBases><Beauty>2</Beauty><BeautyOutdoors>2</BeautyOutdoors><Nutrition>2</Nutrition></statBases>
    <ingestible />
    <plant>
      <!-- Keep the Vanilla Birch growth and wood economy without adding species bonuses. -->
      <growDays>20</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestWork>800</harvestWork>
      <harvestYield>27</harvestYield>
      <wildClusterWeight>24</wildClusterWeight>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Dakekanba_Snow</snowOverlayGraphicPath>
      <leaflessGraphicPath>Things/Plant/AMJ/Dakekanba_Leafless</leaflessGraphicPath>
      <leaflessSnowOverlayGraphicPath>Things/Plant/AMJ/LeaflessNoSnow</leaflessSnowOverlayGraphicPath>
      <!-- Snow on the leafy crown awaits a verified, aligned snow-only overlay. -->
    </plant>
  </ThingDef>

  <ThingDef ParentName="TreeBase">
    <defName>AMJ_Tree_Shirabiso</defName>
    <label>Shirabiso</label>
    <description>Shirabiso (written 白檜曽 in Japanese; also called Shirabe) is a tall evergreen conifer that forms climax forest in Honshu's subalpine zone.\n\nOn Mt. Ontake in the central mountains, subalpine conifer forests of Shirabiso, Veitch's silver fir, spruce, and related trees spread across the mountain slopes.\n\nBy the later medieval period, Ontake had become a destination for mountain asceticism and religious ascent, and forests such as these were part of a mountain-worship landscape distinct from settled lowlands.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Shirabiso</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.15, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
      <Nutrition>1.25</Nutrition>
    </statBases>
    <ingestible />
    <plant>
      <growDays>28</growDays>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Shirabiso_Snow</snowOverlayGraphicPath>
      <minGrowthTemperature>0</minGrowthTemperature>
      <visualSizeRange Inherit="False">
        <min>1.25</min>
        <max>2.7</max>
      </visualSizeRange>
      <harvestWork>850</harvestWork>
      <harvestYield>30</harvestYield>
      <wildClusterWeight>34</wildClusterWeight>
    </plant>
  </ThingDef>

  <ThingDef ParentName="BushBase">
    <defName>AMJ_Shrub_Haimatsu</defName>
    <uiIconPath>Things/Plant/AMJ/Haimatsu/Haimatsu_A</uiIconPath>
    <label>Haimatsu</label>
    <description>Haimatsu (written 這松 in Japanese) is an evergreen dwarf pine distributed in alpine areas from Hokkaido to central and northern Honshu, where it forms dense creeping thickets above the treeline.\n\nIts relict distribution is thought to reflect northern cold-climate plants that moved south during the glacial periods and remained at high elevations after the climate warmed.\n\nMt. Ontake became a destination for religious ascent from the later medieval period, and today Haimatsu scrub spreads across its alpine zone.</description>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>2.60</drawSize>
      <shadowData>
        <volume>(0.20, 0.12, 0.12)</volume>
        <offset>(0,0,-0.10)</offset>
      </shadowData>
    </graphicData>
    <fillPercent>0.18</fillPercent>
    <pathCost>22</pathCost>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestYield>8</harvestYield>
      <harvestTag>Wood</harvestTag>
      <harvestMinGrowth>0.40</harvestMinGrowth>
      <harvestWork>350</harvestWork>
      <harvestFailable>false</harvestFailable>
      <snowOverlayGraphicPath>Things/Plant/AMJ/Haimatsu_Snow</snowOverlayGraphicPath>
      <fertilitySensitivity>0.20</fertilitySensitivity>
      <growDays>18</growDays>
      <minGrowthTemperature>0</minGrowthTemperature>
      <wildClusterRadius>7</wildClusterRadius>
      <wildClusterWeight>28</wildClusterWeight>
      <visualSizeRange Inherit="False">
        <min>0.45</min>
        <max>0.75</max>
      </visualSizeRange>
      <topWindExposure>0.18</topWindExposure>
    </plant>
  </ThingDef>
</Defs>
