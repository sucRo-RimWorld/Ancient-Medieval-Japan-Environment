<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    AMJE owns the two retained Vanilla wetland baseline compositions, not the
    entire wildPlants node. Only remove known Vanilla entries by exact DefName,
    then append approved Vanilla/Hannoki/Suge/Yoshi/Mizugoke weights. The wetland-specific
    Four species transfers retain total and woody commonality exactly; other
    species retain their previous weights. This preserves all other
    current children, including MO's Mindwort/Poppy/Fleawort/FlyAgaric when
    MO patches before Environment. If MO patches afterward, its additions are
    also preserved. This Mod never adds, removes or adjusts MO's herbal entries.

    The conditional removal is safe when Vanilla 1.6 lacks a named entry
    (historical ColdBog/Cypress failure): it does not abort the rest of the
    patch. Do not substitute a whole-node replacement.
    Wild Healroot stays in both wetlands under the separate medicine boundary.
    The stated commonality totals cover only Environment's baseline entries;
    optional Mod additions legitimately increase the loaded total.
  -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- TemperateSwamp: Vanilla+four-species wetland baseline (7.30 total / 3.00 woody).
           Preserve MO/DLC/third-party entries with different DefNames. -->
      <li Class="PatchOperationConditional">
        <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants/*[self::Plant_TallGrass or self::Plant_Brambles or self::Plant_Bush or self::Plant_TreeWillow or self::Plant_TreeMaple or self::Plant_Berry or self::Plant_HealrootWild or self::Plant_Chokevine or self::Plant_TreeCypress]</xpath>
        <match Class="PatchOperationRemove">
          <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants/*[self::Plant_TallGrass or self::Plant_Brambles or self::Plant_Bush or self::Plant_TreeWillow or self::Plant_TreeMaple or self::Plant_Berry or self::Plant_HealrootWild or self::Plant_Chokevine or self::Plant_TreeCypress]</xpath>
        </match>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants</xpath>
        <value>
          <Plant_TallGrass>1.40</Plant_TallGrass>
          <AMJ_Plant_Yoshi>1.00</AMJ_Plant_Yoshi>
          <AMJ_Plant_Suge>0.80</AMJ_Plant_Suge>
          <Plant_Brambles>0.8</Plant_Brambles>
          <Plant_Bush>0.2</Plant_Bush>
          <Plant_TreeWillow>1.30</Plant_TreeWillow>
          <AMJ_Tree_Hannoki>0.70</AMJ_Tree_Hannoki>
          <Plant_TreeMaple>1.0</Plant_TreeMaple>
          <Plant_Berry>0.05</Plant_Berry>
          <Plant_HealrootWild>0.05</Plant_HealrootWild>
        </value>
      </li>

      <!-- ColdBog: Vanilla+Hannoki+Suge baseline (8.22 total / 1.80 woody).
           Preserve MO/DLC/third-party entries with different DefNames. -->
      <li Class="PatchOperationConditional">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/*[self::Plant_TallGrass or self::Plant_Moss or self::Plant_Bush or self::Plant_TreeWillow or self::Plant_TreeBirch or self::Plant_TreeMaple or self::Plant_Berry or self::Plant_HealrootWild or self::Plant_Chokevine or self::Plant_TreeCypress or self::Plant_Astragalus]</xpath>
        <match Class="PatchOperationRemove">
          <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants/*[self::Plant_TallGrass or self::Plant_Moss or self::Plant_Bush or self::Plant_TreeWillow or self::Plant_TreeBirch or self::Plant_TreeMaple or self::Plant_Berry or self::Plant_HealrootWild or self::Plant_Chokevine or self::Plant_TreeCypress or self::Plant_Astragalus]</xpath>
        </match>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants</xpath>
        <value>
          <Plant_TallGrass>1.70</Plant_TallGrass>
          <AMJ_Plant_Yoshi>0.60</AMJ_Plant_Yoshi>
          <AMJ_Plant_Suge>1.10</AMJ_Plant_Suge>
          <Plant_Moss>1.40</Plant_Moss>
          <AMJ_Plant_Mizugoke>1.20</AMJ_Plant_Mizugoke>
          <Plant_Bush>0.3</Plant_Bush>
          <Plant_TreeWillow>0.45</Plant_TreeWillow>
          <Plant_TreeBirch>0.45</Plant_TreeBirch>
          <Plant_TreeMaple>0.45</Plant_TreeMaple>
          <AMJ_Tree_Hannoki>0.45</AMJ_Tree_Hannoki>
          <Plant_Berry>0.07</Plant_Berry>
          <Plant_HealrootWild>0.05</Plant_HealrootWild>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
