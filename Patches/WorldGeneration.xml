<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Replace only the worker for the Vanilla Terrain world-generation step.
       The Environment worker derives from WorldGenStep_Terrain, runs the
       Vanilla terrain pass first, then applies the Japan-oriented adjustments
       before later world-generation steps such as rivers and factions run. -->

  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/WorldGenStepDef[defName="Terrain"]/worldGenStep</xpath>
    <value>
      <worldGenStep Class="AncientMedievalJapan.Environment.WorldGenStep_AMJEnvironmentTerrain" />
    </value>
  </Operation>

</Patch>
