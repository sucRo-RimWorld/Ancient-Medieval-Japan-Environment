<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    TEST-ONLY PlantBase inheritance and native CutPlant probes.
    Loaded solely from the temporary AMJE.EnvironmentQuicktests Mod during
    isolated Quickstarts. Never load from Environment's production Defs.
    Haimatsu's existing approved graphic is reused ONLY as a machine-test
    placeholder; it is not candidate artwork for these wetland species.
    Suge/Yoshi yield=1 and Yoshi's Hay output are experimental mechanics
    ONLY; neither is an approved AMJ_Plant_Yoshi harvest/resource decision.
    Hannoki's wood output and yield=1 are also provisional mechanics,
    not approved production settings.
    An additional WaterYoshi candidate is staged in the temporary
    Quicktests Mod to exercise real GenStep_Plants on fresh wetland maps.
    No production wetland PlantDef is provided here.
  -->
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_Suge</defName>
    <label>test-only sedge cut probe</label>
    <description>Temporary native harvesting probe, not game content.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <!-- PlantBase inherits RawBad; zero-nutrition plants are not food. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestedThingDef>Hay</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestMinGrowth>0.80</harvestMinGrowth>
      <harvestWork>100</harvestWork>
      <harvestFailable>false</harvestFailable>
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_Mizugoke</defName>
    <label>test-only moss cut probe</label>
    <description>Temporary native no-drop removal probe, not game content.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <!-- PlantBase inherits RawBad; zero-nutrition plants are not food. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
    </plant>
  </ThingDef>
  <!-- Probe ONLY: whether an experimental Hay-bearing reed-type PlantBase
       can be harvested by ordinary CutPlant; this is not a production decision. -->
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_Yoshi</defName>
    <label>test-only reed experimental cut probe</label>
    <description>Disposable reed mechanics probe, not game content.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <!-- PlantBase inherits RawBad; this zero-nutrition plant is not food. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestedThingDef>Hay</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestMinGrowth>0.80</harvestMinGrowth>
      <harvestWork>100</harvestWork>
      <harvestFailable>false</harvestFailable>
    </plant>
  </ThingDef>
  <!-- Deciduous alder mechanics only: borrowed accepted beech graphics and
       test yield 1. Neither resource choice, amount nor sowing is approved. -->
  <ThingDef ParentName="DeciduousTreeBase">
    <defName>AMJE_Test_Hannoki</defName>
    <label>test-only alder wood cut probe</label>
    <description>Disposable alder tree mechanics probe, not game content.</description>
    <selectable>true</selectable>
    <!-- Keep test-only zero-nutrition trees from inheriting a food preference. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <graphicData>
      <texPath>Things/Plant/AMJ/Beech</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <leaflessGraphicPath>Things/Plant/AMJ/Beech_Leafless</leaflessGraphicPath>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <harvestTag>Wood</harvestTag>
      <harvestWork>100</harvestWork>
      <harvestFailable>false</harvestFailable>
    </plant>
  </ThingDef>
  <!-- Disposable experimental amphibious freshwater/soil reed:
       loaded into Quicktests-only wetland pools at map generation.
       This is SEPARATE from the unchanged native CutPlant Yoshi probe.
       Borrowed graphics and commonality=0.05 are NOT production choices. -->
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_YoshiDualHabitatSpawn</defName>
    <label>test-only water and soil reed native spawn probe</label>
    <description>Disposable dual-habitat natural spawning experiment.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <minGrowthTemperature>0</minGrowthTemperature>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <wildTerrainTags>
        <li>WaterFreshShallowStill</li>
        <li>Soil</li>
      </wildTerrainTags>
      <wildPlantUseDistanceToShore>true</wildPlantUseDistanceToShore>
      <wildOrder>1</wildOrder>
    </plant>
  </ThingDef>
</Defs>
