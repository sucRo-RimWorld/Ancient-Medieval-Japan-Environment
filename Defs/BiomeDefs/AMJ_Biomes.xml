  <BiomeDef>
    <defName>AMJ_WarmTemperateForest</defName>
    <label>warm-temperate forest</label>
    <description>A humid evergreen broadleaf forest found across the warm-temperate regions of the Japanese archipelago. Evergreen broadleaf trees such as Sudajii dominate, creating a warm, rainy environment.</description>
    <workerClass>AncientMedievalJapan.Environment.BiomeWorker_AMJWarmTemperateForest</workerClass>
    <animalDensity>3.8</animalDensity>
    <plantDensity>0.72</plantDensity>
    <settlementSelectionWeight>1</settlementSelectionWeight>
    <movementDifficulty>1</movementDifficulty>
    <texture>World/Biomes/TemperateForest</texture>
    <forageability>1</forageability>
    <foragedFood>RawBerries</foragedFood>
    <wildPlantRegrowDays>18</wildPlantRegrowDays>
    <soundsAmbient>
      <li>Ambient_NightInsects_Standard</li>
    </soundsAmbient>
    <diseaseMtbDays>50</diseaseMtbDays>
    <terrainsByFertility>
      <li>
        <terrain>AMJ_ThinSoil</terrain>
        <min>-999</min>
        <max>0.30</max>
