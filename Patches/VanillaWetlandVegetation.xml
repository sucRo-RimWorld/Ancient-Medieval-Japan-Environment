<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    AMJE retains the compatible Vanilla TemperateSwamp / ColdBog BiomeDefs.
    Replace only their natural vegetation pools with the approved Japan-oriented
    Phase 5 compositions, preserving the Vanilla wetland worker, terrains, etc.

    Replacing the complete wildPlants node is intentional. The former sequence
    performed individual Chokevine/Cypress removals/replacements and failed at
    ColdBog/Cypress on the user's installed RimWorld 1.6 build. This ownership
    boundary prevents missing/reordered Vanilla plant entries from leaving the
    entire biome vegetation patch in a partially applied state.
    Wild Healroot remains in the wetland pools under the 2026-10-08 medicine-Mod split; do not remove it as a deferred cleanup.
  -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- TemperateSwamp: total commonality=7.30, woody=3.00. -->
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="TemperateSwamp"]/wildPlants</xpath>
        <value>
          <wildPlants>
            <Plant_TallGrass>3.2</Plant_TallGrass>
            <Plant_Brambles>0.8</Plant_Brambles>
            <Plant_Bush>0.2</Plant_Bush>
            <Plant_TreeWillow>2.0</Plant_TreeWillow>
            <Plant_TreeMaple>1.0</Plant_TreeMaple>
            <Plant_Berry>0.05</Plant_Berry>
            <Plant_HealrootWild>0.05</Plant_HealrootWild>
          </wildPlants>
        </value>
      </li>

      <!-- ColdBog: total commonality=8.22, woody=1.80. -->
      <li Class="PatchOperationReplace">
        <xpath>/Defs/BiomeDef[defName="ColdBog"]/wildPlants</xpath>
        <value>
          <wildPlants>
            <Plant_TallGrass>3.4</Plant_TallGrass>
            <Plant_Moss>2.6</Plant_Moss>
            <Plant_Bush>0.3</Plant_Bush>
            <Plant_TreeWillow>0.6</Plant_TreeWillow>
            <Plant_TreeBirch>0.6</Plant_TreeBirch>
            <Plant_TreeMaple>0.6</Plant_TreeMaple>
            <Plant_Berry>0.07</Plant_Berry>
            <Plant_HealrootWild>0.05</Plant_HealrootWild>
          </wildPlants>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
