<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    TEST-ONLY PlantBase inheritance and native CutPlant probes.
    Loaded solely from the temporary AMJE.EnvironmentQuicktests Mod during
    isolated Quickstarts. Never load from Environment's production Defs.
    Haimatsu's existing approved graphic is reused ONLY as a machine-test
    placeholder; it is not candidate artwork for these wetland species.
    Suge/Yoshi yield=1 and Yoshi's Hay output are experimental mechanics
    ONLY; neither is an approved AMJ_Plant_Yoshi harvest/resource decision.
    No production wetland PlantDef is provided here.
  -->
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_Suge</defName>
    <label>test-only sedge cut probe</label>
    <description>Temporary native harvesting probe, not game content.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <!-- PlantBase inherits RawBad; zero-nutrition plants are not food. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestedThingDef>Hay</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestMinGrowth>0.80</harvestMinGrowth>
      <harvestWork>100</harvestWork>
      <harvestFailable>false</harvestFailable>
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_Mizugoke</defName>
    <label>test-only moss cut probe</label>
    <description>Temporary native no-drop removal probe, not game content.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <!-- PlantBase inherits RawBad; zero-nutrition plants are not food. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
    </plant>
  </ThingDef>
  <!-- Probe ONLY: whether an experimental Hay-bearing reed-type PlantBase
       can be harvested by ordinary CutPlant; this is not a production decision. -->
  <ThingDef ParentName="PlantBase">
    <defName>AMJE_Test_Yoshi</defName>
    <label>test-only reed experimental cut probe</label>
    <description>Disposable reed mechanics probe, not game content.</description>
    <selectable>true</selectable>
    <graphicData>
      <texPath>Things/Plant/AMJ/Haimatsu</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <!-- PlantBase inherits RawBad; this zero-nutrition plant is not food. -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <harvestedThingDef>Hay</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestMinGrowth>0.80</harvestMinGrowth>
      <harvestWork>100</harvestWork>
      <harvestFailable>false</harvestFailable>
    </plant>
  </ThingDef>
</Defs>
